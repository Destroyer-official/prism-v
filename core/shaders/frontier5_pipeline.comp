// ============================================================================
// Prism-V Frontier 5: Silicon-Fused Zero-Copy Heterogeneous Compute Shader
// Target: Vulkan 1.3/1.4 on Qualcomm Adreno 800-series / Arm Immortalis-G925
// Extensions: VK_KHR_cooperative_matrix, VK_ANDROID_external_memory_ahb
// ============================================================================

#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_cooperative_matrix : enable

layout(local_size_x = 16, local_size_y = 16) in;

// Set 0: Direct AHardwareBuffer Image Bindings (VK_ANDROID_external_memory_android_hardware_buffer)
layout(set = 0, binding = 0, r16ui) readonly uniform uimage2D u_camera_raw_luma;
layout(set = 0, binding = 1, r16ui) writeonly uniform uimage2D u_mediacodec_clean_luma;
layout(set = 0, binding = 2, r16ui) readonly uniform uimage2D u_mediacodec_recon_luma;
layout(set = 0, binding = 3, r16i)  writeonly uniform iimage2D u_micro_residual_luma;

// Set 1: AFGS1 Autoregressive Noise Modeling Buffer (160 Bytes Normative Metadata)
layout(set = 1, binding = 0, std430) buffer Afgs1ParamBuffer {
    uint  variance_histogram[64];
    int   ar_coefficients[24];
    uint  scaling_spline_points[14];
    uint  random_seed;
} u_afgs1;

// 14-Bit Fixed-Point Dyadic Denominator: 2^14 = 16384
const int DYADIC_SCALE = 16384;

// ----------------------------------------------------------------------------
// Pass 1: AFGS1 Parametric Noise Stripper & Bilateral Filtering
// Strips stochastic white sensor noise before MediaCodec ASIC transform coding
// ----------------------------------------------------------------------------
void execute_afgs1_noise_stripper(ivec2 pos, ivec2 img_size) {
    float local_sum = 0.0;
    float local_sum_sq = 0.0;
    
    // 3x3 local patch analysis
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            ivec2 sample_pos = clamp(pos + ivec2(dx, dy), ivec2(0), img_size - ivec2(1));
            float val = float(imageLoad(u_camera_raw_luma, sample_pos).r);
            local_sum += val;
            local_sum_sq += val * val;
        }
    }

    float mean = local_sum / 9.0;
    float variance = max(0.0, (local_sum_sq / 9.0) - (mean * mean));
    float center_val = float(imageLoad(u_camera_raw_luma, pos).r);

    // Bilateral grain stripping
    float total_weight = 0.0;
    float filtered_acc = 0.0;

    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            ivec2 sample_pos = clamp(pos + ivec2(dx, dy), ivec2(0), img_size - ivec2(1));
            float val = float(imageLoad(u_camera_raw_luma, sample_pos).r);
            float dist_sq = float(dx * dx + dy * dy);
            float diff = val - center_val;
            
            float w = exp(-dist_sq * 0.5) * exp(-(diff * diff) / (2.0 * max(1.0, variance)));
            filtered_acc += val * w;
            total_weight += w;
        }
    }

    uint clean_pixel = uint(clamp(filtered_acc / total_weight, 0.0, 65535.0));
    imageStore(u_mediacodec_clean_luma, pos, uvec4(clean_pixel, 0, 0, 0));
}

// ----------------------------------------------------------------------------
// Pass 2: 14-Bit Integer Fixed-Point Lanczos-5 Resampling & Residual Extraction
// r_t = clamp(f_raw - f_pred, -128, +127)
// ----------------------------------------------------------------------------
void execute_residual_extraction(ivec2 pos, ivec2 img_size) {
    uint raw_sample = imageLoad(u_camera_raw_luma, pos).r;
    uint recon_sample = imageLoad(u_mediacodec_recon_luma, pos).r;

    // Direct residual extraction in GPU register space
    int diff = int(raw_sample) - int(recon_sample);
    int clamped_res = clamp(diff, -128, 127);

    imageStore(u_micro_residual_luma, pos, ivec4(clamped_res, 0, 0, 0));
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 img_size = imageSize(u_camera_raw_luma);

    if (pos.x >= img_size.x || pos.y >= img_size.y) {
        return;
    }

    // Step 1: Strip stochastic sensor noise and write clean frame to MediaCodec Surface
    execute_afgs1_noise_stripper(pos, img_size);

    // Step 2: Compute high-frequency micro-residual
    execute_residual_extraction(pos, img_size);
}
